# Alpha Vantage API Key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Trading Bot Configuration
START_DATE=2020-01-01
END_DATE=2023-12-31
POPULATION_SIZE=50
GENERATIONS=20

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Data Storage
DATA_DIR=data
LOGS_DIR=logs
PLOTS_DIR=plots 